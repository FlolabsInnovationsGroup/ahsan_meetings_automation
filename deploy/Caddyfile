# Caddy gets and renews a Let's Encrypt certificate for {$DOMAIN}
# automatically. The DNS A record must already point at this server, and
# ports 80 and 443 must be open in the security group.
#
# Values come from deploy/caddy.env (see deploy/caddy.env.example).

{$DOMAIN} {
	encode gzip

	# Everything sits behind a password (and the API key, HC_API_TOKEN). n8n
	# or scripts can send the same credentials as a standard
	# "Authorization: Basic ..." header. Two paths are public: the privacy
	# policy (Google requires it on the OAuth consent screen) and Zoom's
	# webhook (Zoom's servers have no password; the app checks Zoom's
	# signature instead, see autopilot/webhook.py).
	@protected not path /privacy /zoom/webhook
	basic_auth @protected {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	# Zoom's webhook calls are a few KB; the public route takes no more.
	request_body /zoom/webhook {
		max_size 256KB
	}

	# Meeting recordings are large. Raise if you upload longer files.
	request_body {
		max_size 4GB
	}

	reverse_proxy app:8000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
