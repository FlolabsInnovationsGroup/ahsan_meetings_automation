# Caddy gets and renews a Let's Encrypt certificate for {$DOMAIN}
# automatically. The DNS A record must already point at this server, and
# ports 80 and 443 must be open in the security group.
#
# Values come from deploy/caddy.env (see deploy/caddy.env.example).

{$DOMAIN} {
	encode gzip

	# The API has no authentication of its own, so everything sits behind
	# a password. n8n or scripts can send the same credentials as a
	# standard "Authorization: Basic ..." header. Only the privacy policy
	# is public: Google requires it on the OAuth consent screen.
	@protected not path /privacy
	basic_auth @protected {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	# Meeting recordings are large. Raise if you upload longer files.
	request_body {
		max_size 4GB
	}

	reverse_proxy app:8000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
