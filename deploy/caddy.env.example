# Copy to deploy/caddy.env on the server and fill in. Never commit caddy.env.

# Domain or subdomain whose DNS A record points at the server's Elastic IP,
# e.g. cutter.flolabsinnovations.com
# No domain yet? Use the free sslip.io name for the Elastic IP, e.g. for
# 3.121.45.67 -> 3-121-45-67.sslip.io
DOMAIN=cutter.example.com

# Login shown by the browser's password prompt.
BASIC_AUTH_USER=flolabs

# bcrypt hash of the password, NOT the password itself. Generate it with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'YOUR-PASSWORD'
# Keep the single quotes: the hash contains "$" characters, and single
# quotes stop docker compose from treating them as variables.
BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_OUTPUT_OF_HASH_PASSWORD'
