# Copy to .env.clips in the repo root on the clips server and fill it in.
# No real values here. Never commit .env.clips.

# --- App settings the clips process needs
STORAGE_DIR=/data-clips
# ^ must equal CLIPS_STORAGE_DIR
LLM_PROVIDER=anthropic
# ^ anthropic (Claude Sonnet) or gemini
ANTHROPIC_API_KEY=
# ^ key for the language model
YOUTUBE_CLIENT_ID=
# ^ OAuth client id of the NEW Google Cloud project
YOUTUBE_CLIENT_SECRET=
# ^ its secret
PUBLIC_BASE_URL=http://localhost:8091
# ^ the address the sign-in redirect returns to
HC_API_TOKEN=
# ^ token the app code expects; any long random string
FFMPEG_BIN=ffmpeg
# ^ ffmpeg command
YTDLP_COOKIES_FILE=
# ^ optional: cookies file path for yt-dlp
YTDLP_PROXY=
# ^ optional: proxy for yt-dlp downloads

# --- Supply and the release-date gate
CLIPS_YOUTUBE_DOWNLOADS=false
# ^ YouTube's terms forbid downloading a video without YouTube's own written permission, even when the
# ^ creator agrees. Off: YouTube sources are not listed or downloaded; use a watched folder. The owner decides.
CLIPS_NOT_BEFORE=2026-11-19
# ^ ISO date (the game's release date). A video dated earlier is skipped, unless its source is official
# ^ material. A video with no known date passes. Empty switches the gate off.

# --- Where things live, and who may call the API
CLIPS_STORAGE_DIR=/data-clips
# ^ the clips data folder
CLIPS_API_TOKEN=
# ^ X-API-Key for the clips page. REQUIRED for any server: with it empty the API only answers when
#   CLIPS_PUBLIC_BASE_URL is localhost (a tunnel or a local run), and answers 503 otherwise.
#   Use a long random string.
CLIPS_PUBLIC_BASE_URL=http://localhost:8091
# ^ public address of the clips page

# --- The one channel this system may post to
CLIPS_CHANNEL_ID=
# ^ the clips channel id (UC...); uploads are refused while empty
CLIPS_FORBIDDEN_CHANNEL_IDS=
# ^ MUST hold the company channel's id (comma separated)
CLIPS_CHANNEL_NAME=
# ^ display name of the clips channel

# --- Posting pace (start slow: hourly posting hurts a new channel)
CLIPS_POSTS_PER_DAY=1
# ^ allowance in the first week
CLIPS_RAMP_STEPS=1,2,2,3,3,3,3,4
# ^ the allowance for week 1, week 2, and so on after the first post (the last value stays)
CLIPS_RAMP_PER_WEEK=0
# ^ above 0, replaces the steps with a straight climb of this many posts a week
CLIPS_MAX_POSTS_PER_DAY=6
# ^ the allowance never passes this
CLIPS_MIN_GAP_MINUTES=180
# ^ at least this long between two posts
CLIPS_WINDOW_START_HOUR=0
# ^ posts go out from this hour ...
CLIPS_WINDOW_END_HOUR=24
# ^ ... until this hour, in the time zone below
CLIPS_TIMEZONE=America/New_York
# ^ time zone for the posting window
CLIPS_LEAD_MINUTES=30
# ^ the earliest slot is this far from now
CLIPS_UPLOAD_AHEAD_HOURS=6
# ^ upload (private, timed) this long before release; keep it short: anything already uploaded
# ^ goes public by itself unless the kill switch can pull it back
CLIPS_REVIEW_REQUIRED=true
# ^ a person approves each clip before it is scheduled

# --- What gets made
CLIPS_SHORTS_PER_VIDEO=3
# ^ Shorts cut from each source video
CLIPS_LONG_PER_VIDEO=1
# ^ longer clips cut from each source video
CLIPS_SHORT_MIN_S=15.0
# ^ shortest Short, seconds
CLIPS_SHORT_MAX_S=58.0
# ^ longest Short, seconds (stay under a minute)
CLIPS_LONG_MIN_S=180.0
# ^ shortest long clip, seconds
CLIPS_LONG_MAX_S=600.0
# ^ longest long clip, seconds
CLIPS_DOWNLOAD_MAX_HEIGHT=1080
# ^ highest video height to download
CLIPS_OUTPUT_FPS=30
# ^ frame rate of rendered clips
CLIPS_CAPTIONS=true
# ^ burn in what is said, when we have the words
CLIPS_VISION=false
# ^ let a vision model look at frames of candidate moments
CLIPS_VISION_MODEL=
# ^ empty: the provider's default small vision model
CLIPS_DEFAULT_HASHTAGS=#gta6,#gtavi
# ^ comma separated hashtags added to every clip
CLIPS_MEDIA_RETENTION_HOURS=48
# ^ delete downloaded media after this many hours

# --- The loop and its brakes
CLIPS_LOOP_MINUTES=15
# ^ minutes between loop turns
CLIPS_VIDEOS_PER_TICK=1
# ^ source videos processed per turn
CLIPS_UPLOADS_PER_TICK=2
# ^ uploads per turn
CLIPS_MAX_UPLOAD_FAILURES=3
# ^ this many failed uploads in a row open the breaker
