# Hugging Face token — required to download the pyannote speaker-diarization
# model that WhisperX uses. Accept the model terms at:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
# then create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=

# --- AI (decides what to cut, picks highlights and shorts, writes chapters) --
# anthropic (default), openai or gemini — only the chosen one needs a key.
LLM_PROVIDER=anthropic
# Create a key at https://console.anthropic.com (the account needs credit).
# claude-sonnet-5-5 (thinking off) costs about $0.08 per 30 minutes of
# meeting; claude-haiku-4-5 is half that but judges worse. Every report.pdf
# shows the job's AI calls, tokens and estimated cost.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Used when LLM_PROVIDER=openai.
# Create a key at https://platform.openai.com/api-keys (the account needs
# billing/credit). gpt-6-luna is OpenAI's budget model: a 98-minute meeting
# costs about $0.02 (~100k input + ~15k output tokens).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# none = no reasoning tokens (cheaper, faster; the task doesn't need them).
OPENAI_REASONING_EFFORT=none

# Optional fallback: only used when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# WhisperX runs locally/self-hosted (no per-minute cost). "small"/"base" are
# CPU-friendly; use "large-v3" if you have a GPU. int8 keeps CPU inference fast.
WHISPERX_MODEL=small
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8
WHISPERX_DIARIZE_MODEL=pyannote/speaker-diarization-3.1

# Where uploaded videos, intermediate clips, and job state are stored.
STORAGE_DIR=./storage

FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Publishing to the company YouTube channel (optional): the final video and
# its shorts. See DEPLOY.md, "Publishing to YouTube". Leave empty if you do
# not publish to YouTube.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Public address of this site, used for the Google sign-in redirect:
# https://YOUR_DOMAIN  ->  redirect URI https://YOUR_DOMAIN/youtube/callback
PUBLIC_BASE_URL=

# YouTube blocks cloud servers (Codespaces, EC2) with "Sign in to confirm
# you're not a bot". Point this at a cookies.txt exported from a signed-in
# browser (Netscape format), and/or set a residential proxy URL.
YTDLP_COOKIES_FILE=
YTDLP_PROXY=

# --- v2 service -----------------------------------------------------------
# API key required as X-API-Key on every route except /health and the UI
# pages. Leave empty only on a local machine; always set it on a server.
HC_API_TOKEN=
# Jobs allowed at once (running + waiting); more get 503 busy.
MAX_QUEUE_DEPTH=1
# Refuse to start a job with less free disk than this (bytes, 6 GiB).
MIN_FREE_DISK_BYTES=6442450944
# Delete finished jobs nobody touched for this many hours, checked at
# startup and every few minutes (0 = never). The page's side panel can
# change it; its choice wins over this line.
JOB_RETENTION_HOURS=30
# Below this much free disk (bytes, 2 GiB), the oldest finished jobs are
# deleted until there is this much again.
LOW_DISK_CLEANUP_BYTES=2147483648
# Dissolves between kept parts (false = hard cuts) and their target length.
TRANSITIONS_ENABLED=true
TRANSITION_TARGET_S=0.5
# Cut the pauses where nobody is speaking, measured in the audio (captions
# can't show them). A pause of >= SILENCE_MIN_S is shortened to a ~0.55 s
# beat: PAD_AFTER is left after speech stops, PAD_BEFORE before it resumes.
# The level that counts as silence adapts to each recording (room tone vs
# speech level); the three dB knobs tune that rule (see core/config.py).
# The UI's "Cut silences" box overrides SILENCE_CUT_ENABLED per job.
SILENCE_CUT_ENABLED=true
SILENCE_MIN_S=1.0
SILENCE_PAD_AFTER_S=0.30
SILENCE_PAD_BEFORE_S=0.25
SILENCE_MIN_MARGIN_DB=6
SILENCE_RANGE_FRACTION=0.35
SILENCE_SPEECH_HEADROOM_DB=18

# --- v2 outputs -----------------------------------------------------------
# Font file for burned-in text (labels, title card, captions). Empty = find
# DejaVu Sans (Linux: apt install fonts-dejavu-core) or Arial automatically.
FONT_FILE=
# "<topic> / Full meeting" card between the highlights reel and the meeting
# in final.mp4, in seconds (0 = none).
TITLE_CARD_S=2
# Intro / outro clips at the very start / end of final.mp4 (nothing else).
# They are found in INTRO_OUTRO_DIR by file name: "intro", "opening", "open"
# or "start" in the name = the intro; "outro", "ending", "closing" or "end" =
# the outro. A missing folder or clip just means no intro / outro.
# The UI's "Add intro & outro" box overrides INTRO_OUTRO_ENABLED per job.
INTRO_OUTRO_ENABLED=true
# Relative paths are inside the project folder (not the folder the server
# was started from).
INTRO_OUTRO_DIR=intro_outro
# Optional: name the clips explicitly instead (empty = find them by name).
INTRO_FILE=
OUTRO_FILE=
# Also ship the reel on its own / a separate copy of the cleaned meeting.
HIGHLIGHTS_FILE_ENABLED=true
KEEP_CLEANED_SEPARATELY=false
# After the zip is written keep the individual files (true, local UI) or
# only the zip + manifest (false, recommended on a small server).
SERVE_INDIVIDUAL_ARTIFACTS=true
# Delete the source recording (inside the job folder) when the job is done.
DELETE_SOURCE_WHEN_DONE=false

# --- Zoom (Server-to-Server OAuth app) -------------------------------------
# From the app's "App credentials" page. The app must be ACTIVATED and have
# the scopes cloud_recording:read:list_user_recordings:admin,
# cloud_recording:read:list_recording_files:admin and
# cloud_recording:read:recording:admin.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Whose cloud recordings the web UI lists by default (an email address).
ZOOM_HOST_EMAIL=
# Never run WhisperX: fail with transcript_not_ready instead (true on EC2).
REQUIRE_NATIVE_TRANSCRIPT=false

# --- Autopilot: post every new team meeting by itself ----------------------
# Each new recording of the accounts ticked "Autopilot" under the Zoom tab
# (PM by default) waits for Zoom's transcript, else is transcribed with
# WhisperX (needs HF_TOKEN above), is processed, and goes to YouTube: the
# shorts first, then the full video. Nothing is ever posted twice; the list
# of what is on YouTube is data/state/posted.jsonl. Switch it on and off
# with the button in the page's side panel (it stays as set across restarts).
# private, unlisted or public. The app can't change it after the upload.
AUTOPILOT_PRIVACY=public
# Hours to wait after a meeting for Zoom's transcript before transcribing.
AUTOPILOT_TRANSCRIPT_WAIT_HOURS=10
# How often to look for new recordings while no job runs (minutes).
AUTOPILOT_CHECK_MINUTES=30
# Only meetings from this day on (YYYY-MM-DD). Empty = the day it is switched
# on. A day in the past also posts the older meetings: look on the channel
# first, the app only knows videos whose job is still on the server.
AUTOPILOT_START_AFTER=
# A failed meeting is processed again this many times, then waits for a person.
AUTOPILOT_MAX_RETRIES=3
# Wall clock of a job that transcribes itself (seconds; 6 h).
ASR_JOB_MAX_WALL_S=21600
# The Zoom account list starts with these (then edit it on the page).
ZOOM_DEFAULT_EMAIL=pm@flomad.com
ZOOM_EMAILS=["zoom.buddy@flolabsinnovations.com"]
# Zoom app > Feature > Event Subscriptions: endpoint https://YOUR_DOMAIN/zoom/webhook,
# events "All recordings have completed" and "Recording transcript files
# have completed". Paste the app's Secret Token here.
ZOOM_WEBHOOK_SECRET_TOKEN=
# Daily copy of data/state to S3 (deploy/backup-state.sh, run by cron on the
# host with the EC2 instance's IAM role). Empty = no S3 copy.
STATE_BACKUP_S3_URI=
